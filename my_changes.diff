-        if (ioctl(fd, MQ_IOC_BULK_PEEK, &args) < 0) {
-            pr_perror("Failed to bulk peek mqueue (fd: %d)", fd);
-            return -1;
-        }
-
-        if (args.out_count == 0)
-            break;
-
-        size_t offset = 0;
-        for (uint32_t i = 0; i < args.out_count; i++) {
-            if (current_msg_idx >= nmsgs) {
-                pr_warn("Kernel returned more messages than expected (%ld)\n", nmsgs);
-                return 0; 
-            }
-
-            struct mq_peek_msg_hdr *hdr = (struct mq_peek_msg_hdr *)(peek_buf + offset);
-
-            if (current_msg_offset == 0) {
-                msgs[current_msg_idx].prio = hdr->msg_prio;
-                msgs[current_msg_idx].len = hdr->total_msg_len;
-                msgs[current_msg_idx].data = xmalloc(hdr->total_msg_len);
-                if (!msgs[current_msg_idx].data)
