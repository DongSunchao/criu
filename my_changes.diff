-
-            if (hdr->flags & MQ_PEEK_FLAG_HAS_MORE) {
-                current_msg_offset += hdr->chunk_len;
-            } else {
-                current_msg_idx++;
-                current_msg_offset = 0;
-            }
-
-            offset += ALIGN8(sizeof(*hdr) + hdr->chunk_len);
